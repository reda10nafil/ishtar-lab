# Modello non operativo. Non usare i segnaposto come password.
# Dopo aver scelto un ambiente separato, compilare e salvare come infra/.env.
# Il Compose originale usa porte 55500/56500/59500 e progetto multi-outfit.
POSTGRES_USER=multi_outfit_app
POSTGRES_DB=multi_outfit
POSTGRES_PASSWORD=REPLACE_WITH_NEW_RANDOM_SECRET
STORAGE_ACCESS_KEY=REPLACE_WITH_NEW_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_NEW_RANDOM_SECRET
